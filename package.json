{
  "name": "ose-proforma",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k \"wrangler pages dev dist --d1 DB --kv OSE_DB --port 8788 --live-reload\" \"vite\"",
    "dev:api": "wrangler pages dev dist --d1 DB --kv OSE_DB --port 8788",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "npm run build && wrangler pages dev dist --d1 DB --kv OSE_DB --port 8788"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hono": "^4.13.23",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.63.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "wrangler": "^4.168.0"
  }
}
